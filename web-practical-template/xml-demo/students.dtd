<!ELEMENT students (student+)>
<!ELEMENT student (name, rollNo, department, email, year)>

<!ATTLIST student
  id ID #REQUIRED
  status (Active | Graduating | Leave) "Active"
>

<!ELEMENT name (#PCDATA)>
<!ELEMENT rollNo (#PCDATA)>
<!ELEMENT department (#PCDATA)>
<!ELEMENT email (#PCDATA)>
<!ELEMENT year (#PCDATA)>